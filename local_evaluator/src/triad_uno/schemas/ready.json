{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad-tactics.local/schemas/v1/ready.json",
  "title": "Ready",
  "description": "Agent -> organizer: handshake reply. request_id must echo initialize.",
  "type": "object",
  "required": [
    "type",
    "request_id"
  ],
  "properties": {
    "type": {
      "const": "ready"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_state": true
  },
  "additionalProperties": false
}
