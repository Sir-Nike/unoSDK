FROM scratch AS ml_wheels
FROM python:3.11-slim AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_LINK_MODE=copy
ARG UV_CONCURRENT_DOWNLOADS=1
ARG UV_HTTP_TIMEOUT=300
COPY examples/ml_fixture/cu128/pyproject.toml ./pyproject.toml
COPY examples/ml_fixture/cu128/uv.lock ./uv.lock
RUN --mount=type=bind,from=ml_wheels,target=/wheels \
    --mount=type=cache,id=uno-ml-cu128-uv,target=/root/.cache/uv,sharing=locked \
    if [ -f /wheels/SHA256SUMS.json ]; then \
      uv export --locked --no-dev --no-emit-project --output-file /tmp/requirements.txt && \
      uv venv /app/.venv && \
      uv pip sync --python /app/.venv/bin/python --require-hashes --offline --no-index \
        --find-links=/wheels /tmp/requirements.txt; \
    else uv sync --locked --no-dev --no-install-project; fi

FROM python:3.11-slim
WORKDIR /app
LABEL org.triad-uno.protocol="1.0" org.triad-uno.runtime="2" org.triad-uno.sdk="uno-sdk-2" \
      org.triad-uno.cpu="0.5" org.triad-uno.ram-bytes="1073741824" \
      org.triad-uno.scratch-bytes="1073741824" org.triad-uno.pids="128" \
      org.triad-uno.gpu="true" org.triad-uno.gpu-bytes="536870912"
COPY --from=dependencies /app/.venv ./.venv
COPY src/ ./src/
COPY examples/ml_fixture/ ./examples/ml_fixture/
COPY models/ ./models/
COPY examples/ml_fixture/submission.cuda.json ./submission.json
ENV PATH="/app/.venv/bin:$PATH"
RUN python examples/ml_fixture/model.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 HOME=/tmp
ENV UNO_REQUIRE_CUDA=1
USER 10000:10000
ENTRYPOINT ["python", "examples/ml_fixture/agent.py"]
